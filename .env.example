# Copy to .env and fill in the keys for the providers you use.
# .env is git-ignored — never commit real keys.

# LLM providers (see src/llms.py)
KISKI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SAP system (see src/abap_interaction.py)
# Defaults match the SAP ABAP Cloud Developer Trial Docker image;
# only change them if your system differs.
SAP_HOST=http://localhost:50000
SAP_USER=DEVELOPER
SAP_PASSWORD=ABAPtr2025#SP00
SAP_CLIENT=001
